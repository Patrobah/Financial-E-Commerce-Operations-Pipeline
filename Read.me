## vba 2. VBA Normalization Machine Code (`NormalizeGlobalSaaS_Ledger`)
Developed a highly resilient, automated transformation macro in Excel. Instead of hardcoding static exchange rates, it dynamically executes lookups against the decoupled database arrays sitting in the `Relational_Schema` tab, logging transactional logs and catching malformed fields gracefully:

```vba
Sub NormalizeGlobalSaaS_Ledger()
    Dim wsMaster As Worksheet
    Dim wsEngine As Worksheet
    Dim wsSchema As Worksheet
    Dim lastRow As Long
    Dim i As Long

    Dim rawAmount As Variant
    Dim currencyStr As String
    Dim normalizedAmount As Double
    Dim rateMultiplier As Variant

    On Error GoTo ErrorHandler

    Set wsMaster = ThisWorkbook.Sheets("Data_Master")
    Set wsSchema = ThisWorkbook.Sheets("Relational_Schema")

    ' Clear out prior automated processing sheets to prevent overlap duplication
    On Error Resume Next
    Application.DisplayAlerts = False
    ThisWorkbook.Sheets("Analytical_Engine").Delete
    Application.DisplayAlerts = True
    On Error GoTo ErrorHandler

    Set wsEngine = ThisWorkbook.Sheets.Add(After:=wsMaster)
    wsEngine.Name = "Analytical_Engine"

    ' Design Relational Column Headers
    wsEngine.Cells(1, 1).Value = "Transaction_ID"
    wsEngine.Cells(1, 2).Value = "Timestamp"
    wsEngine.Cells(1, 3).Value = "Customer_ID"
    wsEngine.Cells(1, 4).Value = "Plan_Type"
    wsEngine.Cells(1, 5).Value = "Original_Amount"
    wsEngine.Cells(1, 6).Value = "Original_Currency"
    wsEngine.Cells(1, 7).Value = "Normalized_Amount_USD"
    wsEngine.Cells(1, 8).Value = "Pipeline_Audit_Status"

    With wsEngine.Rows(1)
        .Font.Bold = True
        .Interior.Color = RGB(44, 62, 80)
        .Font.Color = RGB(255, 255, 255)
    End With

    lastRow = wsMaster.Cells(wsMaster.Rows.Count, "A").End(xlUp).Row

    For i = 2 To lastRow
        wsEngine.Cells(i, 1).Value = wsMaster.Cells(i, 1).Value
        wsEngine.Cells(i, 2).Value = wsMaster.Cells(i, 2).Value
        wsEngine.Cells(i, 3).Value = wsMaster.Cells(i, 3).Value
        wsEngine.Cells(i, 4).Value = wsMaster.Cells(i, 4).Value

        rawAmount = wsMaster.Cells(i, 5).Value
        currencyStr = UCase(Trim(wsMaster.Cells(i, 6).Value))

        wsEngine.Cells(i, 5).Value = rawAmount
        wsEngine.Cells(i, 6).Value = currencyStr

        If IsEmpty(rawAmount) Or rawAmount <= 0 Or IsNull(rawAmount) Then
            wsEngine.Cells(i, 7).Value = 0
            wsEngine.Cells(i, 8).Value = "CRITICAL: Missing Core Transaction Value"
            wsEngine.Rows(i).Interior.Color = RGB(255, 235, 204)
        Else
            ' DYNAMIC RELATIONAL LOOKUP: Fetch exchange multiplier from the Relational_Schema sheet range
            rateMultiplier = Application.VLookup(currencyStr, wsSchema.Range("A2:B10"), 2, False)

            If IsError(rateMultiplier) Then
                wsEngine.Cells(i, 7).Value = CDbl(rawAmount)
                wsEngine.Cells(i, 8).Value = "WARNING: Currency Code Missing From Schema Map"
                wsEngine.Rows(i).Interior.Color = RGB(255, 204, 204)
            Else
                normalizedAmount = CDbl(rawAmount) * CDbl(rateMultiplier)
                wsEngine.Cells(i, 7).Value = normalizedAmount
                wsEngine.Cells(i, 8).Value = "Passed: Normalized via Relational Schema lookup"
            End If

            wsEngine.Cells(i, 7).NumberFormat = "$#,##0.00"
        End If
    Next i

    wsEngine.Columns("A:H").AutoFit
    MsgBox "🎉 Data Operational Normalization Complete via Relational Schema Tables!", vbInformation, "Pipeline Success"
    Exit Sub

ErrorHandler:
    MsgBox "❌ Operational pipeline crash: " & Err.Description, vbCritical, "System Architecture Fault"
End Sub
```

